# ============================================================
# 环境变量配置模板
# 使用方法: 复制本文件为 .env 并填写真实值
#   cp .env.example .env
# ============================================================

# LLM Provider: "mock" 使用模拟LLM, "qwen" 使用通义千问API
LLM_PROVIDER=qwen

# 通义千问 (Qwen) API配置
# 从阿里云DashScope控制台获取: https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=sk-your-api-key-here
QWEN_MODEL=qwen-max

# 数据库配置 (可选，不配置时自动使用Mock数据)
DB_HOST=192.168.88.128
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=loudi_food

# LangFuse 可观测性 (可选，不配置时自动禁用 trace 上报)
# 从 LangFuse 控制台获取: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
